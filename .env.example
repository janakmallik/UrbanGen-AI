# UrbanGen-AI environment configuration
#
# Copy this file to .env and fill in your local paths:
#   cp .env.example .env
#
# .env is gitignored. Never commit your actual paths.

# Root directory containing the BDD100K dataset (parent of `bdd100k/`)
URBANINTEL_DATA_ROOT=/path/to/ml-data

# Path to a local checkout of UrbanMind-AI (source of split manifests and
# the Week 5 ResNet-50 checkpoint)
URBANMIND_REPO=/path/to/UrbanMind-AI